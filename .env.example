# ============================================================================
# P2P Shield Chat - Environment Configuration
# ============================================================================

# Supabase Project Credentials (used for Auth, Profiles, Contacts, and Ephemeral Signaling ONLY)
# Never put your Supabase service_role key here! Only the public Anon key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# STUN Servers Configuration (STRICTLY NO TURN SERVERS ALLOWED)
VITE_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302

# Maximum Direct P2P File Transfer Size (in MB, default: 50MB for WebRTC DataChannel memory safety)
VITE_MAX_FILE_SIZE_MB=50

# Application Version
VITE_APP_VERSION=1.0.0
